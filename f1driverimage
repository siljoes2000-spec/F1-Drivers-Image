<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <title>F1 Driver Outfit Customizer</title>
  <style>
    body { font-family: Arial, sans-serif; background:#111; color:#eee; padding:20px; }
    select, input { margin: 6px 0; }
    canvas { background:#222; margin-top:20px; }
    .panel { display:flex; gap:40px; flex-wrap:wrap; }
    .controls { max-width:300px; }
  </style>
</head>
<body>
  <h1>F1 Driver Outfit Customizer</h1>

  <div class="panel">
    <div class="controls">
      <h3>Preset assets</h3>
      <label>Face:</label><br />
      <select id="faceSelect"></select><br />

      <label>Suit:</label><br />
      <select id="suitSelect"></select><br />

      <h3>Custom uploads</h3>
      <label>Upload face:</label><br />
      <input type="file" id="faceUpload" accept="image/*" /><br />

      <label>Driver name:</label><br />
      <input type="text" id="driverName" placeholder="Oscar Piastri" /><br />

      <label>Country code (e.g. AUS, ITA):</label><br />
      <input type="text" id="countryCode" placeholder="AUS" /><br />

      <button onclick="renderImage()">Render</button>
    </div>

    <div>
      <canvas id="canvas" width="400" height="800"></canvas>
    </div>
  </div>

<script>
// ---- CONFIG ----
// You add your own assets here
const faces = {
  piastri: 'assets/faces/piastri.png',
  leclerc: 'assets/faces/leclerc.png'
};

const suits = {
  ferrari: 'assets/suits/ferrari.png',
  mclaren: 'assets/suits/mclaren.png'
};

// ---- SETUP ----
const faceSelect = document.getElementById('faceSelect');
const suitSelect = document.getElementById('suitSelect');

Object.keys(faces).forEach(k => faceSelect.add(new Option(k, k)));
Object.keys(suits).forEach(k => suitSelect.add(new Option(k, k)));

const canvas = document.getElementById('canvas');
const ctx = canvas.getContext('2d');

let uploadedFaceImg = null;

document.getElementById('faceUpload').addEventListener('change', e => {
  const file = e.target.files[0];
  if (!file) return;
  const img = new Image();
  img.onload = () => uploadedFaceImg = img;
  img.src = URL.createObjectURL(file);
});

function loadImage(src) {
  return new Promise(res => {
    const img = new Image();
    img.onload = () => res(img);
    img.src = src;
  });
}

async function renderImage() {
  ctx.clearRect(0,0,canvas.width,canvas.height);

  // Load suit
  const suit = await loadImage(suits[suitSelect.value]);
  ctx.drawImage(suit, 0, 0, canvas.width, canvas.height);

  // Load face
  let face;
  if (uploadedFaceImg) {
    face = uploadedFaceImg;
  } else {
    face = await loadImage(faces[faceSelect.value]);
  }

  // Draw face (adjust position/size per your assets)
  ctx.drawImage(face, 130, 40, 140, 140);

  // Name + flag
  const name = document.getElementById('driverName').value || faceSelect.value;
  const country = document.getElementById('countryCode').value || '';

  ctx.font = '24px Arial';
  ctx.fillStyle = 'white';
  ctx.textAlign = 'center';
  ctx.fillText(name.toUpperCase(), canvas.width/2, 230);

  ctx.font = '18px Arial';
  ctx.fillText(country.toUpperCase(), canvas.width/2, 260);
}
</script>
</body>
</html>
